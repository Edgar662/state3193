# Copie este arquivo para ".env" e preencha com seus valores.

# Connection string do Postgres (Supabase). Pegue em Project Settings > Connect > Transaction pooler.
DATABASE_URL="postgresql://postgres.xxxx:SENHA@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Mesma coisa, mas na porta 5432 (Session pooler) — usada só para rodar migrações.
DIRECT_URL="postgresql://postgres.xxxx:SENHA@aws-1-us-east-2.pooler.supabase.com:5432/postgres"

# Gere um valor aleatorio: openssl rand -base64 32
AUTH_SECRET=""

# Usados apenas por `npm run seed` para criar o primeiro admin
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="changeme123"

# Numero do estado exibido na marca do site
NEXT_PUBLIC_STATE_NUMBER="3193"
